; Engine configuration file.
; Ripple Garden — see docs/02_TECH_SPEC.md for architecture.

config_version=5

[application]

config/name="Ripple Garden"
config/version="0.2.0"
run/main_scene="res://world/world_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
ContentDB="*res://autoload/content_db.gd"
SaveService="*res://autoload/save_service.gd"
TimeService="*res://autoload/time_service.gd"
AudioService="*res://autoload/audio_service.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
