# Normalize line endings: Godot and CI (Linux) both expect LF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.res binary
*.scn binary
*.translation binary
